# The wallet that receives payment AND executes the swap. Two ways to hold it.
#
# A) A CDP account. Nothing here holds a key: signing happens inside Coinbase's
#    TEE. The address is resolved at startup and becomes BASE_PAY_TO, so the
#    two cannot disagree. Needs CDP credentials in the environment.
#    Use a NAME OF ITS OWN — never a production account.
BASE_CDP_ACCOUNT_NAME=sign402-stocks-seller

# B) Or a local private key. Then BASE_PAY_TO must be that key's own address:
#    settlement pays it and the swap spends from it, and the server refuses to
#    start if they differ.
# BASE_FACILITATOR_KEY=0x...
# BASE_PAY_TO=0x...

# Needs ETH on Base for gas: the payer signs a message, we pay for every
# transaction in the sequence.

BASE_RPC_URL=https://base-rpc.publicnode.com
BASE_PUBLIC_URL=https://stocks.example.com
PORT=8413

# Our cut, in basis points, added on top of the order (100 = 1%).
BASE_FEE_BPS=100

# Order size bounds in USD. The ceiling is about pool depth, not caution.
BASE_MIN_USD=1
BASE_MAX_USD=250

# How far below the quote a fill may land before the swap reverts and the
# buyer is refunded. 150 = 1.5%.
BASE_SLIPPAGE_BPS=150
