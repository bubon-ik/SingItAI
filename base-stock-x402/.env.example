# The wallet that receives payment AND executes the swap. These must be the
# same address: settlement pays BASE_PAY_TO, the swap spends from the key.
# The server refuses to start if they differ.
BASE_FACILITATOR_KEY=0x...
BASE_PAY_TO=0x...

# Needs ETH on Base for gas: the payer signs a message, we pay for every
# transaction in the sequence.

BASE_RPC_URL=https://base-rpc.publicnode.com
BASE_PUBLIC_URL=https://stocks.example.com
PORT=8413

# Our cut, in basis points, added on top of the order (100 = 1%).
BASE_FEE_BPS=100

# Order size bounds in USD. The ceiling is about pool depth, not caution.
BASE_MIN_USD=1
BASE_MAX_USD=250

# How far below the quote a fill may land before the swap reverts and the
# buyer is refunded. 150 = 1.5%.
BASE_SLIPPAGE_BPS=150
