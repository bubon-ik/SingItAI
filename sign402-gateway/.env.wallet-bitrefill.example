# Copy this file to .env.wallet-bitrefill and fill only local secrets.
# Do not commit the real .env.wallet-bitrefill file.

# Required for authenticated live Bitrefill MCP calls.
BITREFILL_API_KEY=

# Optional MCP endpoint override. Keep the official HTTPS endpoint in production.
# Must stay query-free: the API key is appended as a path segment.
SIGN402_BITREFILL_MCP_URL=https://api.bitrefill.com/mcp

# Bitrefill affiliate code, attached as ?ref= after the API key. Earns 1% back
# in BTC on attributed purchases. Bare code only, no leading "ref=".
SIGN402_BITREFILL_AFFILIATE_REF=

# Required for local hardware confirmation while we test.
FIREFLY_PORT=/dev/cu.usbmodem11301

# Intentionally low for local smoke tests; production uses the separately
# reviewed value in /etc/sign402-gateway.env.
SIGN402_BITREFILL_LIVE_MAX_USD=1.00
SIGN402_BITREFILL_LIVE_MAX_INVOICE_OVERAGE_BPS=500
SIGN402_MAX_SINGIT_PER_BITREFILL_ORDER=200000
