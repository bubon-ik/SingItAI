# Copy this file to .env.wallet-bitrefill and fill only local secrets.
# Do not commit the real .env.wallet-bitrefill file.

# Required for authenticated live Bitrefill MCP calls.
BITREFILL_API_KEY=

# Optional MCP endpoint override. Keep the official HTTPS endpoint in production.
# Must stay query-free: the API key is appended as a path segment.
SIGN402_BITREFILL_MCP_URL=https://api.bitrefill.com/mcp

# Bitrefill affiliate code, attached as ?ref= after the API key. Earns 1% back
# in BTC on attributed purchases. Bare code only, no leading "ref=".
SIGN402_BITREFILL_AFFILIATE_REF=

# Which checkout the gateway buys through: "account" (default) signs the MCP
# session with BITREFILL_API_KEY, "guest" opens it unauthenticated so the order
# is attributable to the affiliate code above — a purchase made from the account
# that owns the code never is. Guest checkout requires
# SIGN402_WALLET_MASTER_KEY, a buyer email per user, and a payment method other
# than "balance" (a guest has no account balance to spend).
SIGN402_BITREFILL_CHECKOUT_MODE=account

# Required in guest checkout: buyer emails and guest invoice access tokens are
# only ever written encrypted with this key.
SIGN402_WALLET_MASTER_KEY=

# Required for local hardware confirmation while we test.
FIREFLY_PORT=/dev/cu.usbmodem11301

# Intentionally low for local smoke tests; production uses the separately
# reviewed value in /etc/sign402-gateway.env.
SIGN402_BITREFILL_LIVE_MAX_USD=1.00
SIGN402_BITREFILL_LIVE_MAX_INVOICE_OVERAGE_BPS=500

# Safety margin the priced token amount keeps over the USDC total, because that
# same floor is re-checked against a fresh swap quote seconds later. At 0 the
# amount clears the floor by a hair and ordinary price movement refunds the
# order. Stays inside the 5% reprice ceiling the buyer approves.
SIGN402_BITREFILL_PRICING_BUFFER_BPS=200
SIGN402_MAX_SINGIT_PER_BITREFILL_ORDER=200000
