# Bankr LLM credits and API key purchase.
# Keep real secrets in /etc/sign402-gateway.env, never in this file.

SIGN402_BANKR_API_URL=https://api.bankr.bot
SIGN402_BANKR_LLM_URL=https://llm.bankr.bot
SIGN402_BANKR_LLM_STORE_PATH=/home/hermes/.sign402/bankr-llm.db
SIGN402_BANKR_HTTP_TIMEOUT_SECONDS=20
SIGN402_BANKR_OTP_TTL_SECONDS=600
SIGN402_BANKR_MAX_OTP_ATTEMPTS=3

# Background settlement sweep. A Bankr top-up can outlive the request that
# started it; the sweep finishes those purchases once the credit lands, so a
# buyer is not left on RECONCILIATION_REQUIRED waiting for a manual reconcile.
# It only reads the balance - it never tops up again.
SIGN402_BANKR_LLM_AUTO_SETTLE=1
SIGN402_BANKR_LLM_SETTLE_INTERVAL_SECONDS=30
SIGN402_BANKR_LLM_SETTLE_MAX_AGE_SECONDS=604800

# The same key encrypts managed wallets, Bankr API keys, Bitrefill recipients,
# and reveal tokens at rest. Rotating it requires a separately reviewed migration.
SIGN402_WALLET_MASTER_KEY=

# Existing real-rate SINGIT pricing must remain enabled.
SIGN402_BITREFILL_PRICING_MODE=bankr_real_rate
SIGN402_MAX_SINGIT_PER_BITREFILL_ORDER=

# Spending limits (USDC atomic, 6 decimals).
# MAX/DAILY are starting defaults a user may raise from Telegram.
# CEILING values are hard maximums no user can exceed; unset = no ceiling.
# Production ceilings permit a $1,000 Bitrefill product plus the 2% fee.
# Users may choose lower personal limits through /limits.
SIGN402_USER_WALLET_MAX_ATOMIC_PER_TX=10000
SIGN402_USER_WALLET_DAILY_ATOMIC_CAP=100000
SIGN402_USER_WALLET_CEILING_ATOMIC_PER_TX=1020000000
SIGN402_USER_WALLET_CEILING_DAILY_ATOMIC=5000000000

# Bitrefill product/invoice cap before the 2% Sign402 service fee.
SIGN402_BITREFILL_LIVE_MAX_USD=1000.00

# Per-user rate limits (empty or 0 disables a limit).
SIGN402_USER_REQUESTS_PER_MINUTE=60
SIGN402_USER_PURCHASES_PER_HOUR=20

# Set to a truthy value only for maintenance. Every route in
# FUND_MOVING_POST_PATHS returns 503 before reading the request body or
# dispatching a handler.
SIGN402_PURCHASES_PAUSED=

# WhatsApp Business payment approvals via Meta Cloud API.
# Use a permanent Meta System User token in production. Never commit it.
SIGN402_WHATSAPP_ACCESS_TOKEN=
SIGN402_WHATSAPP_PHONE_NUMBER_ID=
SIGN402_WHATSAPP_TEMPLATE_NAME=sign402_payment_approval
SIGN402_WHATSAPP_TEMPLATE_LANGUAGE=en_US
SIGN402_WHATSAPP_GRAPH_API_VERSION=v25.0
SIGN402_WHATSAPP_HTTP_TIMEOUT_SECONDS=20

# Spending Memory: the record the purchase decision is read out of, and the
# amount that may be spent from it without asking. The autonomy cap is not the
# user's daily limit — that one is enforced by the reservation and is larger.
# This is the smaller question: how much the agent may settle on its own.
SPENDING_MEMORY_DB=~/.sibyl-memory/memory.db
SPENDING_MEMORY_AUTONOMY_CAP=0.50
# Kill switch, gateway-side. 0 returns the gateway to asking before every
# payment and remembering nothing — no deploy needed. Unset means on.
SIGN402_SPENDING_MEMORY_ENABLED=1

# --- Onchain readings from The Graph -------------------------------------
# Answers "price of WETH" and a bare "$WETH" from the actual Uniswap V3 pool
# on Base instead of a paid web search, for $0.01 a query and no API key.
#
# Off unless set to 1, and it refuses to build when spending memory is off:
# every query is authorised by the same policy and daily cap as a gift card,
# so paying for data with no cap and no provider memory cannot happen by
# accident. Anything it declines falls through to the web search unchanged.
SIGN402_ONCHAIN_DATA_ENABLED=0
# Uniswap V3 on Base. Pinned, not discovered — a chat message must not get to
# choose which contract is trusted.
SIGN402_ONCHAIN_SUBGRAPH=GqzP4Xaehti8KSfQmv3ZctFSjnSUYZ4En5NRsiTbvZpz
# Ceiling on one query, atomic USDC. The gateway quotes 10000 ($0.01).
SIGN402_ONCHAIN_MAX_PER_CALL_ATOMIC=20000
# A pool shallower than this does not get its price repeated. The top Base
# USDC pool by liquidity is a fabrication holding a nominal $21bn whose token
# symbol is "unknown"; depth is the cheapest thing that filters it out.
SIGN402_ONCHAIN_MIN_LIQUIDITY_USD=50000
# How long the same question is answered from the journal without paying.
SIGN402_ONCHAIN_CACHE_TTL_SECONDS=300

# --- Device approval for escalated payments ------------------------------
# When spending memory escalates a payment, require an EIP-712 signature from
# a Ledger instead of a tap in iMessage or WhatsApp. The device renders the
# merchant, amount and payout address on a screen the host cannot repaint, and
# the signature is bound to the journal entry that caused the escalation — so
# one approval releases exactly one payment.
#
# Off unless set to 1. With it off the escalation path is byte-for-byte the one
# that shipped, and the whole suite proves it.
SIGN402_LEDGER_APPROVAL_ENABLED=0
# Addresses allowed to approve, comma-separated. The gateway refuses every
# approval when this is empty rather than waving payments through.
SIGN402_LEDGER_APPROVER_ADDRESSES=
# The chain the approvals name. Base, because that is where the payments settle.
SIGN402_LEDGER_APPROVAL_CHAIN_ID=8453
