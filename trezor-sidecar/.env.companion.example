# User computer only. This process connects outbound to the VPS HTTPS URL.
SIGN402_TREZOR_COMPANION_ENABLED=0
SIGN402_TREZOR_BROKER_URL=https://replace-with-your-vps-host/trezor-companion
SIGN402_TREZOR_COMPANION_TOKEN_PATH=${HOME}/.config/sign402-trezor-companion/token
SIGN402_TREZOR_COMPANION_POLL_SECONDS=2

# This is the separate bearer for the loopback sidecar, not the Suite MCP token.
SIGN402_TREZOR_SIDECAR_TOKEN=
