# Separate VPS process. Keep all three flags at 0 until the no-purchase test.
SIGN402_TREZOR_BROKER_ENABLED=0
SIGN402_TREZOR_BROKER_HOST=127.0.0.1
SIGN402_TREZOR_BROKER_PORT=8122
SIGN402_TREZOR_BROKER_STATE_PATH=${HOME}/.sign402-trezor-broker/state.db
SIGN402_TREZOR_BROKER_INTERNAL_TOKEN=replace-with-a-random-32-byte-secret

# Separate remote purchase service. Existing gateway and /bitrefill stay unchanged.
SIGN402_TREZOR_POC_ENABLED=0
SIGN402_TREZOR_REMOTE_AGENT_ENABLED=0
SIGN402_TREZOR_REMOTE_PURCHASES_ENABLED=0
SIGN402_TREZOR_REMOTE_AGENT_PORT=8123
SIGN402_TREZOR_REMOTE_AGENT_TOKEN=replace-with-another-random-32-byte-secret
SIGN402_TREZOR_REMOTE_USER_ID=replace-with-one-telegram-user-id
SIGN402_TREZOR_BROKER_URL=http://127.0.0.1:8122
SIGN402_TREZOR_POC_MAX_USD=1.00
SIGN402_TREZOR_REMOTE_STATE_PATH=${HOME}/.sign402-trezor-broker/purchase-state.db
SIGN402_TREZOR_REMOTE_BUYER_EMAIL=

# Reuse the already configured Bitrefill credential only in the VPS agent
# environment. Never copy it to the user's companion.
BITREFILL_API_KEY=

# Only these three values go into the working Hermes environment.
SIGN402_TREZOR_REMOTE_PLUGIN_ENABLED=0
SIGN402_TREZOR_REMOTE_AGENT_URL=http://127.0.0.1:8123
# SIGN402_TREZOR_REMOTE_AGENT_TOKEN must match the remote service value above.
