# Optional. No environment file is loaded automatically.
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# SINGIT_STATE_DIR=/absolute/private/path
# SOLANA_KEYPAIR_FILE=/absolute/private/path/wallet.json
# Alternatively supply a base58-encoded 64-byte keypair through the environment.
# Never pass private keys as CLI arguments or send them in chat.
# SOLANA_PRIVATE_KEY=
